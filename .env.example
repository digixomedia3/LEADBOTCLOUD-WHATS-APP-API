# Copy to .env (never commit .env). Names only here.
NODE_ENV=development
APP_URL=http://localhost:3000
MARKETING_URL=http://localhost:3000
WORKER_URL=http://localhost:4000
REALTIME_URL=http://localhost:4000
DATABASE_URL=postgres://app:app_dev_password@localhost:5433/leadbotcloud
DATABASE_URL_WORKER=postgres://worker:worker_dev_password@localhost:5433/leadbotcloud
DATABASE_URL_MIGRATE=postgres://owner:owner_dev_password@localhost:5433/leadbotcloud
REDIS_URL=redis://localhost:6380
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage-data
SIGNED_URL_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_WEBHOOK_VERIFY_TOKEN=
META_ES_CONFIG_ID=
META_ES_VERSION=v4
META_SYSTEM_USER_TOKEN=
TOKEN_ENCRYPTION_KEY=
MAIL_TRANSPORT=console

# Extra allowed origins for auth (comma-separated). Dev only; production uses APP_URL.
TRUSTED_ORIGINS=

# Email (password reset). MAIL_TRANSPORT=console prints mails to the server log; smtp sends them.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                  # e.g. LeadBotCloud <no-reply@yourdomain>

# Public company details shown on the legal pages and footer. Must match the Meta Business verification.
COMPANY_LEGAL_NAME=DigiXoMedia
COMPANY_ADDRESS=
COMPANY_GSTIN=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=

# Razorpay subscriptions (billing). Use test-mode keys until you go live. The webhook URL to register in the Razorpay dashboard is
# https://<your-worker-host>/webhooks/razorpay with events subscription.* enabled; paste the secret you choose there below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public address of the worker (lead capture + billing webhooks), no trailing slash. Shown to users as the address to post leads to.
WORKER_PUBLIC_URL=
# Set true only when the worker sits behind a trusted proxy/tunnel, so per-IP rate limits use the real client address.
TRUST_PROXY=false

# Server-to-server: web app signs calls to the worker (lead import). Use a long random value; the same value in both apps.
INTERNAL_API_SECRET=
# Address the web app uses to reach the worker privately (defaults to WORKER_PUBLIC_URL).
WORKER_INTERNAL_URL=
