# __SITE__ is replaced at install time. A real domain gets a real certificate; the sslip.io name works the same way.
{
	servers {
		trusted_proxies static private_ranges
	}
}

__SITE__ {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	request_body {
		max_size 12MB
	}

	log {
		output file /var/log/caddy/lbc.log {
			roll_size 20MB
			roll_keep 5
		}
		format json
	}

	# Never reachable from outside: the web app calls these over localhost.
	@internal path /internal/*
	handle @internal {
		respond 404
	}

	# Meta, Shopify and Razorpay webhooks and the public form/lead endpoints go to the worker.
	@worker path /webhooks/* /forms/* /leads/* /healthz
	handle @worker {
		reverse_proxy 127.0.0.1:4000
	}

	# Everything else is the panel.
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
